# Root-only, non-secret x-ui adapter profile.  The API never reads this file;
# only myproxy-xui-helper.service loads it before opening /etc/x-ui/x-ui.db.
MYPROXY_XUI_DB_PATH=/etc/x-ui/x-ui.db
MYPROXY_XUI_INBOUND_ID=1
# The host comes from deployment.json. Set MYPROXY_SERVER_HOST only to override it.
MYPROXY_FINGERPRINT=chrome
MYPROXY_FLOW=xtls-rprx-vision
MYPROXY_SPIDER_X=/
