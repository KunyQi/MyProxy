    <x:Double x:Key="Stroke.OrbIcon">1.8</x:Double>
    <Thickness x:Key="Thickness.ButtonPadding">12,0</Thickness>
    <Thickness x:Key="Thickness.TextInputPadding">8,0</Thickness>
    <Thickness x:Key="Thickness.SwitchContentMargin">8,0,0,0</Thickness>
    <Thickness x:Key="Thickness.SwitchThumbLeft">2,0,0,0</Thickness>
    <Thickness x:Key="Thickness.None">0</Thickness>
    <Thickness x:Key="Thickness.PageVertical">0,24,0,24</Thickness>
    <Thickness x:Key="Thickness.Hairline">1</Thickness>
    <Thickness x:Key="Thickness.SegmentLeft">1,1,0,1</Thickness>
    <Thickness x:Key="Thickness.SegmentRight">0,1,1,1</Thickness>
    <Thickness x:Key="Thickness.TopXS">0,4,0,0</Thickness>
    <Thickness x:Key="Thickness.TopSM">0,8,0,0</Thickness>
    <Thickness x:Key="Thickness.TopMD">0,12,0,0</Thickness>
    <Thickness x:Key="Thickness.TopLG">0,16,0,0</Thickness>
    <Thickness x:Key="Thickness.TopXL">0,24,0,0</Thickness>
    <Thickness x:Key="Thickness.LeftXS">4,0,0,0</Thickness>
    <Thickness x:Key="Thickness.LeftSM">8,0,0,0</Thickness>
    <CornerRadius x:Key="Radius.MD.Left">6,0,0,6</CornerRadius>
    <CornerRadius x:Key="Radius.MD.Right">0,6,6,0</CornerRadius>
    <StreamGeometry x:Key="Geometry.ChevronRight">M 0.75,0.75 L 5.75,5.75 L 0.75,10.75</StreamGeometry>
    <StreamGeometry x:Key="Geometry.ChevronLeft">M 5.75,0.75 L 0.75,5.75 L 5.75,10.75</StreamGeometry>
    <StreamGeometry x:Key="Geometry.ArrowUp">M 2.1,5.4 L 5.5,2 L 8.9,5.4 M 5.5,2 L 5.5,9</StreamGeometry>
    <StreamGeometry x:Key="Geometry.ArrowDown">M 2.1,5.6 L 5.5,9 L 8.9,5.6 M 5.5,9 L 5.5,2</StreamGeometry>
    <StreamGeometry x:Key="Geometry.SpinnerArc">M 6,1 A 5,5 0 0 1 11,6</StreamGeometry>
    <x:TimeSpan x:Key="Motion.Duration.Fast">0:0:0.100</x:TimeSpan>
    <x:TimeSpan x:Key="Motion.Duration.Base">0:0:0.150</x:TimeSpan>
    <x:TimeSpan x:Key="Motion.Duration.SpinnerCycle">0:0:0.9</x:TimeSpan>
    <ea:CubicEaseOut x:Key="Motion.Ease.Out" />
    <x:TimeSpan x:Key="Motion.Duration.Breath">0:0:2.8</x:TimeSpan>
    <x:TimeSpan x:Key="Motion.Duration.Pulse">0:0:1.2</x:TimeSpan>
    <x:TimeSpan x:Key="Motion.Duration.Press">0:0:0.080</x:TimeSpan>
    <x:TimeSpan x:Key="Motion.Duration.Spring">0:0:0.140</x:TimeSpan>
    <x:TimeSpan x:Key="Motion.Duration.Slide">0:0:0.200</x:TimeSpan>
    <ea:SineEaseInOut x:Key="Motion.Ease.Breath" />
    <ea:CubicEaseOut x:Key="Motion.Ease.Spring" />
    <ea:CubicEaseOut x:Key="Motion.Ease.Slide" />
    <ea:CubicEaseOut x:Key="Motion.Ease.Overshoot" />
