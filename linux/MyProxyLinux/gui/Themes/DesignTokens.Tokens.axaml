    <StreamGeometry x:Key="Geometry.PowerArc">M 10.54,13.36 A 12,12 0 1 0 29.46,13.36</StreamGeometry>
    <StreamGeometry x:Key="Geometry.PowerStem">M 20,7.25 L 20,18.75</StreamGeometry>
    <x:Double x:Key="Size.TrafficArrow">11</x:Double>
    <!-- ============ 别名令牌 ============
         同一个共享样式里、同一个属性在三套皮肤下取值不同的那些位置。
         取值从 windows/MyProxy/Themes/DesignTokens.xaml 逐条比出来（.probe/skin-diff.py）
         并搬到这里，于是共享样式引用别名就能让三套皮肤都逐值一致。
         生成器里的表是三份皮肤共用的：任意一套缺一项，生成器直接报错。 -->
    <SolidColorBrush x:Key="Alias.OrbRim.Idle" Color="{DynamicResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Alias.OrbRim.Connected" Color="{DynamicResource Color.SuccessGlow}" />
    <SolidColorBrush x:Key="Alias.OrbRim.Connecting" Color="{DynamicResource Color.AccentGlow}" />
    <SolidColorBrush x:Key="Alias.OrbRim.Error" Color="{DynamicResource Color.ErrorGlow}" />
    <SolidColorBrush x:Key="Alias.OrbIcon.Idle" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Alias.OrbIcon.Connected" Color="{DynamicResource Color.SuccessText}" />
    <SolidColorBrush x:Key="Alias.OrbIcon.Connecting" Color="{DynamicResource Color.AccentText}" />
    <SolidColorBrush x:Key="Alias.OrbIcon.Error" Color="{DynamicResource Color.ErrorText}" />
    <x:Double x:Key="Alias.OrbSpecularWidth">96</x:Double>
    <x:Double x:Key="Alias.OrbSpecularHeight">56</x:Double>
    <Thickness x:Key="Alias.OrbSpecularMargin">0,40,0,0</Thickness>
    <HorizontalAlignment x:Key="Alias.OrbSpecularAlign">Center</HorizontalAlignment>
    <x:String x:Key="Alias.OrbHoverScale">1.02</x:String>
    <x:String x:Key="Alias.OrbPressScale">0.93</x:String>
    <SolidColorBrush x:Key="Alias.CheckFill.Hover" Color="{DynamicResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Alias.CheckFill.Pressed" Color="{DynamicResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Alias.CheckFill.Disabled" Color="{DynamicResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Alias.FocusRingBrush" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Alias.StatusText.Connected" Color="{DynamicResource Color.SuccessText}" />
    <SolidColorBrush x:Key="Alias.StatusText.Connecting" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Alias.StatusText.Error" Color="{DynamicResource Color.ErrorText}" />
    <SolidColorBrush x:Key="Alias.TextLink.HoverFill" Color="{DynamicResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Alias.TextLink.HoverStroke" Color="{DynamicResource Color.Border}" />
</ResourceDictionary>
