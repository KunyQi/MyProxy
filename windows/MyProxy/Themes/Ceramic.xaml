        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="StatusGlyphSlotStyle" TargetType="{x:Type Grid}">
        <Setter Property="Width" Value="{StaticResource Size.StatusGlyph}" />
        <Setter Property="Height" Value="{StaticResource Size.LinePrimary}" />
    </Style>

    <Style x:Key="ModeSegmentRowStyle" TargetType="{x:Type Grid}">
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- 分隔线在釉陶里是**刻痕**：一道暗线加一道下唇的光。 -->
    <Style x:Key="SettingsGroupRuleStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="{StaticResource Size.Hairline}" />
        <Setter Property="Background" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Glaze.Rim}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.RimBottom}" />
    </Style>

    <Style x:Key="SettingsRowStyle" TargetType="{x:Type Grid}">
        <Setter Property="Height" Value="{StaticResource Size.SettingsRow}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ============ 文本样式 ============ -->
    <Style x:Key="PageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="PrimaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizePrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeBody}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="SuccessCaptionTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Brush.SuccessText}" />
    </Style>

    <Style x:Key="DestructiveTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeCaption}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="StatusPrimaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizePrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Foreground" Value="{StaticResource Brush.SuccessText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Disconnecting">
                <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusGlyphTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource StatusPrimaryTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusSubTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="SectionLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="InlineErrorTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="FocusRingStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border BorderBrush="{StaticResource Brush.AccentText}"
                            BorderThickness="{StaticResource Thickness.Hairline}"
                            CornerRadius="{StaticResource Radius.SM}"
                            Margin="{StaticResource Thickness.Hairline}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 控件样式 ============ -->

    <!-- 主按钮：一块青釉凸起。
         常态 = 凸釉 + 顶缘高光 + 接触影；
         按下 = 整体下移 1px、釉翻凹、高光挪到底唇、影消失。
         色相全程不变——变的是材质。 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource Size.PrimaryButton}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Glaze.Accent.Convex}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentPressed}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Sink" Y="0" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Effect="{StaticResource Shadow.Contact}"
                                SnapsToDevicePixels="True" />
                        <!-- 顶缘高光：1px 单边，画在填充之上、内容之下 -->
                        <Border x:Name="Rim"
                                BorderBrush="{StaticResource Brush.Glaze.Rim}"
                                BorderThickness="{StaticResource Thickness.RimTop}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Margin="{StaticResource Thickness.Hairline}"
                                IsHitTestVisible="False" />
                        <!-- 底缘暗边 = 这件瓷自己的厚度。少了它，凸起就只是个亮边贴纸。 -->
                        <Border x:Name="Shade"
                                BorderBrush="{StaticResource Brush.Glaze.Shade}"
                                BorderThickness="{StaticResource Thickness.RimBottom}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Margin="{StaticResource Thickness.Hairline}"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glaze.Accent.Concave}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Rim" Property="BorderThickness" Value="{StaticResource Thickness.RimBottom}" />
                            <Setter TargetName="Rim" Property="BorderBrush" Value="{StaticResource Brush.Glaze.Bounce}" />
                            <Setter TargetName="Shade" Property="BorderThickness" Value="{StaticResource Thickness.RimTop}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sink"
                                                         Storyboard.TargetProperty="Y"
                                                         To="2"
                                                         Duration="{StaticResource Motion.Duration.Press}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sink"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Spring}"
                                                         EasingFunction="{StaticResource Motion.Ease.Spring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 素胎：没上釉，所以连渐变和高光一起撤掉 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glaze.Bisque}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Rim" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Shade" Property="Visibility" Value="Hidden" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource Size.PrimaryButton}" />
        <Setter Property="Background" Value="{StaticResource Glaze.Surface.Convex}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeBody}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Sink" Y="0" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Effect="{StaticResource Shadow.Contact}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Rim"
                                BorderBrush="{StaticResource Brush.Glaze.Rim}"
                                BorderThickness="{StaticResource Thickness.RimTop}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Margin="{StaticResource Thickness.Hairline}"
                                IsHitTestVisible="False" />
                        <!-- 底缘暗边 = 这件瓷自己的厚度。少了它，凸起就只是个亮边贴纸。 -->
                        <Border x:Name="Shade"
                                BorderBrush="{StaticResource Brush.Glaze.Shade}"
                                BorderThickness="{StaticResource Thickness.RimBottom}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Margin="{StaticResource Thickness.Hairline}"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glaze.Surface.Concave}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Rim" Property="BorderThickness" Value="{StaticResource Thickness.RimBottom}" />
                            <Setter TargetName="Rim" Property="BorderBrush" Value="{StaticResource Brush.Glaze.Bounce}" />
                            <Setter TargetName="Shade" Property="BorderThickness" Value="{StaticResource Thickness.RimTop}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sink"
                                                         Storyboard.TargetProperty="Y"
                                                         To="2"
                                                         Duration="{StaticResource Motion.Duration.Press}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sink"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Spring}"
                                                         EasingFunction="{StaticResource Motion.Ease.Spring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glaze.Bisque}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Rim" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Shade" Property="Visibility" Value="Hidden" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文字链接：没有材质（不是一件瓷），hover 才浮起一层浅釉 -->
    <Style x:Key="TextLinkButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Padding" Value="{StaticResource Thickness.TextInputPadding}" />
        <Setter Property="Height" Value="{StaticResource Size.TextLink}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Border x:Name="HoverLayer"
                                Background="{StaticResource Glaze.Surface.Convex}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="{StaticResource Thickness.Hairline}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}"
                                                         FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackLinkButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TextLinkButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
    </Style>

    <Style x:Key="InlineLinkButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TextLinkButtonStyle}">
        <Setter Property="Height" Value="{StaticResource Size.LineSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
    </Style>

    <Style x:Key="SettingsNavRowStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TextLinkButtonStyle}">
        <Setter Property="Height" Value="{StaticResource Size.SettingsRow}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeBody}" />
    </Style>

    <Style x:Key="IconChevronStyle" TargetType="{x:Type Path}">
        <Setter Property="Stroke" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="StrokeThickness" Value="{StaticResource Stroke.Icon}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconChevronDestructiveStyle"
           TargetType="{x:Type Path}"
           BasedOn="{StaticResource IconChevronStyle}">
        <Setter Property="Stroke" Value="{StaticResource Brush.ErrorText}" />
    </Style>

    <!-- 输入框：一口凹进胎里的井。顶缘落影、底唇积光，正好是凸起的反相。 -->
    <Style x:Key="TextInputStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource Glaze.Well.Concave}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeBody}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Padding" Value="{StaticResource Thickness.TextInputPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.SM}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <!-- 底唇的回光。凹陷的标志就是这道光在下边缘而不是上边缘。 -->
                        <Border x:Name="Lip"
                                BorderBrush="{StaticResource Brush.Glaze.Bounce}"
                                BorderThickness="{StaticResource Thickness.RimBottom}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Margin="{StaticResource Thickness.Hairline}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glaze.Bisque}" />
                            <Setter TargetName="Lip" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentText}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextInputErrorStateStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource TextInputStyle}">
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Error}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConnectingSpinnerStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Width" Value="{StaticResource Size.Spinner}" />
        <Setter Property="Height" Value="{StaticResource Size.Spinner}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="SpinnerRoot" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Grid.RenderTransform>
                        <Ellipse Stroke="{StaticResource Brush.BorderStrong}"
                                 StrokeThickness="{StaticResource Stroke.Spinner}" />
                        <Path Data="{StaticResource Geometry.SpinnerArc}"
                              Stroke="{StaticResource Brush.AccentText}"
                              StrokeThickness="{StaticResource Stroke.Spinner}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRoot"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="{StaticResource Motion.Duration.SpinnerCycle}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段控件：托盘是凹的，选中的那格是从托盘里**升起来**的一块瓷。 -->
    <Style x:Key="SegmentedControlItemStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="{StaticResource Glaze.Surface.Convex}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeBody}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                <Setter Property="FontWeight" Value="Medium" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Glaze.Bisque}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                <Setter Property="FontWeight" Value="Medium" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="False" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SegmentedItemLeftStyle"
           TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource SegmentedControlItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid SnapsToDevicePixels="True">
                        <!-- 托盘底：凹 -->
                        <Border Background="{StaticResource Glaze.Well.Concave}"
                                CornerRadius="{StaticResource Radius.MD.Left}" />
                        <!-- 升起的那格：凸釉 + 顶缘高光 -->
                        <Border x:Name="SelectionLayer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{StaticResource Thickness.SegmentLeft}"
                                CornerRadius="{StaticResource Radius.MD.Left}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="Rim"
                                BorderBrush="{StaticResource Brush.Glaze.Rim}"
                                BorderThickness="{StaticResource Thickness.RimTop}"
                                CornerRadius="{StaticResource Radius.MD.Left}"
                                Margin="{StaticResource Thickness.Hairline}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="Rim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Base}" />
                                        <DoubleAnimation Storyboard.TargetName="Rim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 三格分段控件的中间格：方角，描边与左格同一份厚度（接缝处只画一条）。
         设置页的「外观」用它；两格的控件用不到，但组件库要能表达三格。 -->
    <!-- 外观三档分段控件的宽度：三格各 62，刚好装下两个汉字加左右内距。
         它右对齐在内容右轴上，与同页的开关、chevron 共用同一条右边界。 -->
    <sys:Double x:Key="Size.ThemePicker">186</sys:Double>
    <CornerRadius x:Key="Radius.None">0</CornerRadius>
    <Thickness x:Key="Thickness.SegmentMiddle">1,1,0,1</Thickness>

    <Style x:Key="SegmentedItemMiddleStyle"
           TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource SegmentedControlItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid SnapsToDevicePixels="True">
                        <!-- 托盘底：凹 -->
                        <Border Background="{StaticResource Glaze.Well.Concave}"
                                CornerRadius="{StaticResource Radius.None}" />
                        <!-- 升起的那格：凸釉 + 顶缘高光 -->
                        <Border x:Name="SelectionLayer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{StaticResource Thickness.SegmentMiddle}"
                                CornerRadius="{StaticResource Radius.None}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="Rim"
                                BorderBrush="{StaticResource Brush.Glaze.Rim}"
                                BorderThickness="{StaticResource Thickness.RimTop}"
                                CornerRadius="{StaticResource Radius.None}"
                                Margin="{StaticResource Thickness.Hairline}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="Rim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Base}" />
                                        <DoubleAnimation Storyboard.TargetName="Rim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedItemRightStyle"
           TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource SegmentedControlItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{StaticResource Glaze.Well.Concave}"
                                CornerRadius="{StaticResource Radius.MD.Right}" />
                        <Border x:Name="SelectionLayer"
