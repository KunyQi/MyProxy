                      BlurRadius="42" ShadowDepth="14" Direction="270"
                      Opacity="0.24" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Shadow.OrbContact" Color="{StaticResource Color.Shadow}"
                      BlurRadius="10" ShadowDepth="4" Direction="270"
                      Opacity="0.15" RenderingBias="Quality" />

    <!-- ============ 页面骨架容器（纯几何，与另两套相同） ============ -->
