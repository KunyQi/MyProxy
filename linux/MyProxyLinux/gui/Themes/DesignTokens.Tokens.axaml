        <GradientStop Offset="0.864" Color="#FFA85A5E" />
        <GradientStop Offset="0.902" Color="#9EA85A5E" />
        <GradientStop Offset="0.939" Color="#52A85A5E" />
        <GradientStop Offset="0.972" Color="#1FA85A5E" />
        <GradientStop Offset="1.000" Color="#00A85A5E" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Brush.SuccessGlow" Color="{StaticResource Color.SuccessGlow}" />
    <SolidColorBrush x:Key="Brush.ErrorGlow" Color="{StaticResource Color.ErrorGlow}" />
    <RadialGradientBrush x:Key="Brush.Orb.Idle" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" Center="0.5,0.5">
        <GradientStop Offset="0" Color="#FDFDFB" />
        <GradientStop Offset="0.50" Color="#FBFBF9" />
        <GradientStop Offset="0.78" Color="#F5F5F4" />
        <GradientStop Offset="0.91" Color="#E9EAE8" />
        <GradientStop Offset="1" Color="#D2D5D3" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Orb.Connected" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" Center="0.5,0.5">
        <GradientStop Offset="0" Color="#FDFDFB" />
        <GradientStop Offset="0.50" Color="#FBFCFA" />
        <GradientStop Offset="0.78" Color="#F2F8F5" />
        <GradientStop Offset="0.91" Color="#D8E9E0" />
        <GradientStop Offset="1" Color="#8FBEA7" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Orb.Accent" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" Center="0.5,0.5">
