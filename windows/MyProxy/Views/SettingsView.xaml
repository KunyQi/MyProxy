<UserControl x:Class="MyProxy.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="720"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="{DynamicResource Brush.Background}">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 控制层 ================= -->
        <Grid Grid.Row="0" Height="{StaticResource Size.NavBar}">
            <Grid Width="{StaticResource Size.ContentWidth}" HorizontalAlignment="Center">
                <Button Command="{Binding CloseCommand}"
                        Style="{StaticResource BackLinkButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Geometry.ChevronLeft}"
                              Style="{StaticResource IconChevronStyle}" />
                        <TextBlock Text="返回"
                                   Margin="{StaticResource Thickness.LeftXS}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="设置"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Style="{StaticResource PageTitleTextStyle}" />
            </Grid>

            <!-- 通栏：这条线的含义是「换层」，所以它不内缩 -->
            <Border Height="{StaticResource Size.Hairline}"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource Brush.Border}" />
        </Grid>

        <!-- ================= 内容层 ================= -->
        <Grid Grid.Row="1" Style="{StaticResource PageRootStyle}" VerticalAlignment="Top">
            <StackPanel>

                <!-- 身份放最上：这一页最该先回答的是「这台机器绑的是谁」。
                     数据早就在 DeviceConfig 里，只是以前从不显示。 -->
                <StackPanel Visibility="{Binding DeviceVisibility}">
                    <Grid Style="{StaticResource ReservedLineStyle}">
                        <TextBlock Text="设备"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionLabelTextStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DeviceName}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="已绑定"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SuccessCaptionTextStyle}" />
                    </Grid>
                    <TextBlock Text="{Binding BoundAtText}"
                               Margin="{StaticResource Thickness.TopXS}"
                               Style="{StaticResource CaptionTextStyle}" />
                    <Border Height="{StaticResource Space.XXL}" />
                </StackPanel>

                <!-- 连接模式：这里只解释两种模式的差别，开关本身留在主页。
                     把开关也搬过来会让「换个模式」变成两次跳转；而只给两个名字
                     不给说明，用户就只能靠猜。所以主页给开关，这里给说明。 -->
                <Grid Style="{StaticResource ReservedLineStyle}">
                    <TextBlock Text="连接模式"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionLabelTextStyle}" />
                </Grid>
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <TextBlock Text="{Binding RuleModeName}"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}" />
                </Grid>
                <TextBlock Text="{Binding RuleModeDescription}"
                           Style="{StaticResource CaptionTextStyle}" />
                <Border Style="{StaticResource SettingsGroupRuleStyle}" />
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <TextBlock Text="{Binding GlobalModeName}"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}" />
                </Grid>
                <TextBlock Text="{Binding GlobalModeDescription}"
                           Style="{StaticResource CaptionTextStyle}" />
                <Border Height="{StaticResource Space.XXL}" />

                <Grid Style="{StaticResource ReservedLineStyle}">
                    <TextBlock Text="通用"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionLabelTextStyle}" />
                </Grid>
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="自动启动客户端" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                    <CheckBox Grid.Column="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsChecked="{Binding AutoStart, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchStyle}" />
                </Grid>
                <!-- 内缩到左轴：这条线的含义是「同一组的两行」 -->
                <Border Style="{StaticResource SettingsGroupRuleStyle}" />
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="启动后自动连接" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                    <CheckBox Grid.Column="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchStyle}" />
                </Grid>
                <Border Style="{StaticResource SettingsGroupRuleStyle}" />
                <!-- 外观：三档材质。这是一条**立刻可见**的设置，所以不做二级页面——
                     按下去的那一刻整页就换了材质，跳一层页面反而看不见自己改了什么。
                     它与上面两条同属「通用」：都是这台机器上 MyProxy 自己的偏好。 -->
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="界面外观" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                    <Grid Grid.Column="1"
                          Width="{StaticResource Size.ThemePicker}"
                          Height="{StaticResource Size.Control}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0"
                                     GroupName="UiTheme"
                                     Content="经典"
                                     Style="{StaticResource SegmentedItemLeftStyle}"
                                     IsChecked="{Binding IsThemeClassic, Mode=TwoWay}" />
                        <RadioButton Grid.Column="1"
                                     GroupName="UiTheme"
                                     Content="瓷白"
                                     Style="{StaticResource SegmentedItemMiddleStyle}"
                                     IsChecked="{Binding IsThemePorcelain, Mode=TwoWay}" />
                        <RadioButton Grid.Column="2"
                                     GroupName="UiTheme"
                                     Content="釉陶"
                                     Style="{StaticResource SegmentedItemRightStyle}"
                                     IsChecked="{Binding IsThemeCeramic, Mode=TwoWay}" />
                    </Grid>
                </Grid>

                <Border Height="{StaticResource Space.XXL}" />

                <Grid Style="{StaticResource ReservedLineStyle}">
                    <TextBlock Text="更新"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionLabelTextStyle}" />
                </Grid>
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="自动检查更新" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                    <CheckBox Grid.Column="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsChecked="{Binding AutoUpdateCheck, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchStyle}" />
                </Grid>
                <!-- 版本不占一行：它是「更新」这件事的当前状态，不是一条可操作项 -->
                <TextBlock Text="{Binding VersionText}"
                           Margin="{StaticResource Thickness.TopXS}"
                           Style="{StaticResource CaptionTextStyle}" />

                <Grid Margin="{StaticResource Thickness.TopXS}"
                      Style="{StaticResource ReservedLineStyle}">
                    <Button Content="{Binding UpdateText}"
                            Command="{Binding UpdateCommand}"
                            Visibility="{Binding UpdateVisibility}"
                            Style="{StaticResource InlineLinkButtonStyle}" />
                </Grid>

                <!-- 第三档距离：明显大于组间，把「重新绑定」推出所有分组之外 -->
                <Border Height="{StaticResource Space.Detach}" />

                <Button Command="{Binding RebindCommand}"
                        Style="{StaticResource SettingsNavRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="重新绑定"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DestructiveTextStyle}" />
                        <Path Grid.Column="1"
                              Data="{StaticResource Geometry.ChevronRight}"
                              Style="{StaticResource IconChevronDestructiveStyle}" />
                    </Grid>
                </Button>
                <TextBlock Text="解绑这台设备，需要重新输入配对码"
                           Margin="{StaticResource Thickness.TopXS}"
                           Style="{StaticResource CaptionTextStyle}" />

                <!-- 诊断入口是这一页最不重要的东西：页脚链接，与主页底部的「设置」同一模式 -->
                <Button Margin="{StaticResource Thickness.TopXL}"
                        Content="查看日志"
                        Command="{Binding OpenLogCommand}"
                        Style="{StaticResource TextLinkButtonStyle}" />

            </StackPanel>
        </Grid>

        <!-- 错误槽：常驻占位，文字出现/消失时上方版面纹丝不动 -->
        <Grid Grid.Row="2"
              Width="{StaticResource Size.ContentWidth}"
              HorizontalAlignment="Center"
              Style="{StaticResource ReservedLineStyle}">
            <TextBlock Text="{Binding ErrorMessage}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       TextAlignment="Left"
                       Visibility="{Binding ErrorVisibility}"
                       Style="{StaticResource InlineErrorTextStyle}" />
        </Grid>
    </Grid>
</UserControl>
