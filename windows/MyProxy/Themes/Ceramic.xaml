                                BorderThickness="{StaticResource Thickness.SegmentRight}"
                                CornerRadius="{StaticResource Radius.MD.Right}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="Rim"
                                BorderBrush="{StaticResource Brush.Glaze.Rim}"
                                BorderThickness="{StaticResource Thickness.RimTop}"
                                CornerRadius="{StaticResource Radius.MD.Right}"
                                Margin="{StaticResource Thickness.Hairline}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="Rim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionLayer"
