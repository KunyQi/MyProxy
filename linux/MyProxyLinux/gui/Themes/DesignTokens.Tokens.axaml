        <GradientStop Offset="0.78" Color="#F9F0F0" />
        <GradientStop Offset="0.91" Color="#EFDADB" />
        <GradientStop Offset="1" Color="#CB9A9D" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Orb.Specular" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" Center="0.5,0.5">
        <GradientStop Offset="0" Color="#59FFFFFF" />
        <GradientStop Offset="0.5" Color="#1FFFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </RadialGradientBrush>
    <FontFamily x:Key="Font.Family">Inter, Noto Sans CJK SC, Source Han Sans SC, Noto Sans SC, WenQuanYi Micro Hei, DejaVu Sans, sans-serif</FontFamily>
    <x:Double x:Key="Font.SizeTitle">20</x:Double>
