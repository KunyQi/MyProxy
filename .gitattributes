* text=auto eol=lf

# Preserve third-party binary inputs without text conversion.
*.aar binary
*.jar binary
*.ico binary
*.png binary

# Upstream license/source checksums refer to original bytes, including CRLF.
licenses/** -text
android/MyProxyAndroid/vendor/libv2ray/upstream/** -text
android/MyProxyAndroid/vendor/libv2ray/BUILD-INFO.json -text
windows/MyProxy/Assets/Core/LICENSE -text

# Geo databases are binary protobuf assets. Never apply text conversion or diffs.
*.dat binary

# Release binaries and archives must remain byte-for-byte unchanged.
*.exe binary
*.dll binary
*.pdb binary
*.apk binary
*.zip binary

# These are deployed on Linux; never check them out with CRLF on Windows.
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.conf.template text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# The Linux client is packaged and installed on Linux: desktop entries and the
# kernel binary must survive packaging unchanged.
*.desktop text eol=lf

# The Linux kernel binary is a ~36 MB ELF executable: never diff or convert it.
linux/MyProxyLinux/assets/xray binary
