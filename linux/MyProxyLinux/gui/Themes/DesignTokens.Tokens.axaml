        <GradientStop Offset="0.91" Color="#D3E4EC" />
        <GradientStop Offset="1" Color="#87B4C5" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Orb.Error" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5" Center="0.5,0.5">
        <GradientStop Offset="0" Color="#FDFDFB" />
