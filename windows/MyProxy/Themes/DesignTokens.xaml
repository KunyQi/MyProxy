    <!-- Toggle：关闭=边框块，开启=Accent 块。无 Content 时收掉内容边距，
         否则轨道右缘比同页版本号 / chevron 早 8 DIP 收边，控件列对不齐。 -->
    <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                  SnapsToDevicePixels="True">
                        <Border x:Name="SwitchRoot"
                                Width="{StaticResource Size.SwitchTrackWidth}"
                                Height="{StaticResource Size.SwitchTrackHeight}"
                                CornerRadius="{StaticResource Radius.SM}"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.BorderStrong}"
                                BorderThickness="{StaticResource Thickness.Hairline}"
                                VerticalAlignment="Center">
                            <Grid>
                                <!-- 开启态用叠加层淡入，而不是直接换 Background：
                                     共享 StaticResource 笔刷不能做 ColorAnimation。 -->
                                <Border x:Name="SwitchOnLayer"
                                        Background="{StaticResource Brush.Accent}"
                                        CornerRadius="{StaticResource Radius.SwitchTrackInner}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <!-- 拨块是圆角方块不是正圆：R 由轨道推出（见同心圆角 token）。
                                     开启态填骨白 Brush.Surface 而不是纯白：这是一块实体面，
                                     全套界面里所有的面都是 #FCFCFA，纯白会是唯一的例外。
                                     （文字另算：实底按钮上的白字是釉上的墨，不是面。） -->
                                <Border x:Name="Thumb"
                                        SnapsToDevicePixels="True"
                                        Width="{StaticResource Size.SwitchThumb}"
                                        Height="{StaticResource Size.SwitchThumb}"
                                        CornerRadius="{StaticResource Radius.SwitchThumb}"
                                        Background="{StaticResource Brush.BorderStrong}"
                                        HorizontalAlignment="Left"
                                        Margin="{StaticResource Thickness.SwitchThumbLeft}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbShift" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="SwitchContent"
                                          Margin="{StaticResource Thickness.SwitchContentMargin}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="SwitchContent" Property="Margin" Value="{StaticResource Thickness.None}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchRoot" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource Brush.Surface}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Size.SwitchThumbTravel}"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="SwitchOnLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="SwitchOnLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SwitchRoot" Property="Background" Value="{StaticResource Brush.Background}" />
                            <Setter TargetName="SwitchRoot" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                            <Setter TargetName="SwitchOnLayer" Property="Background" Value="{StaticResource Brush.Border}" />
                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource Brush.BorderStrong}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ============ 尺寸 Token（浮空层） ============ -->
    <sys:Double x:Key="Size.Orb">140</sys:Double>
    <sys:Double x:Key="Size.OrbHalo">196</sys:Double>
    <!-- 光晕比槽小：Size.OrbHalo 同时是 Button 的宽高（点击热区）与 MainView 里
         能量球那条 band 的高度，装饰变细不该带着热区和版面节奏一起变。
         可见的环 = (162 − 140) ÷ 2 = 11px。 -->
    <sys:Double x:Key="Size.OrbGlow">162</sys:Double>
    <sys:Double x:Key="Size.OrbIcon">40</sys:Double>
    <!-- 釉边只是釉的收口，不是描上去的线：1px + 淡一档的状态色。
         加粗或用面积色会立刻读成「描了个边的白球」。 -->
    <sys:Double x:Key="Size.GlazeRim">1</sys:Double>
    <sys:Double x:Key="Size.OrbSpecularWidth">96</sys:Double>
    <sys:Double x:Key="Size.OrbSpecularHeight">56</sys:Double>
    <sys:Double x:Key="Size.OrbSpecularTop">16</sys:Double>

    <!-- 模式开关：轨道 352 宽，两侧各留 4 的滑块内嵌量 -->
    <sys:Double x:Key="Size.ModeTrackHeight">44</sys:Double>
    <sys:Double x:Key="Size.ModeThumbWidth">168</sys:Double>
    <sys:Double x:Key="Size.ModeThumbHeight">36</sys:Double>
    <!-- 滑块必须与文字列同心：轨道 352 分两列各 176，文字中心在 88 / 264。
         宽 168 加左右各 4 的内缩，滑块中心正好落在 4+84=88；行程取整列宽 176，
         推到右列后中心 = 176+88 = 264，右侧内缩同样是 4。
         旧值 172/172 让滑块中心停在 90 / 262，与文字差 2px 且两端反向。 -->
    <sys:Double x:Key="Size.ModeThumbTravel">176</sys:Double>

    <sys:Double x:Key="Size.CheckButton">40</sys:Double>
    <sys:Double x:Key="Size.TrafficChart">44</sys:Double>
    <sys:Double x:Key="Size.TrafficLabel">18</sys:Double>

    <CornerRadius x:Key="Radius.LG">10</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">12</CornerRadius>
    <Thickness x:Key="Thickness.ModeThumbInset">4,0,0,0</Thickness>
    <Thickness x:Key="Thickness.TopXXL">0,32,0,0</Thickness>
    <Thickness x:Key="Thickness.CheckPadding">20,0</Thickness>

    <!-- ============ 多重微阴影 ============
         WPF 一个元素只能挂一个 Effect，所以「多重」靠嵌套两层元素实现：
         外层投大而散的环境影（物体离基座多远），内层投紧贴的接触影（物体压住了什么）。
         只有两层同时在，控件才读起来是浮着的而不是贴了张纸。 -->
    <DropShadowEffect x:Key="Shadow.Ambient" Color="{StaticResource Color.Shadow}"
                      BlurRadius="18" ShadowDepth="5" Direction="270"
                      Opacity="0.055" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Shadow.Contact" Color="{StaticResource Color.Shadow}"
                      BlurRadius="4" ShadowDepth="1" Direction="270"
                      Opacity="0.045" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Shadow.OrbAmbient" Color="{StaticResource Color.Shadow}"
                      BlurRadius="22" ShadowDepth="5" Direction="270"
                      Opacity="0.065" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Shadow.OrbContact" Color="{StaticResource Color.Shadow}"
                      BlurRadius="6" ShadowDepth="1" Direction="270"
                      Opacity="0.045" RenderingBias="Quality" />

    <!-- ============ 动效 Token（浮空层） ============ -->
    <!-- 呼吸：非线性，靠 SineEase 在两端放慢，中段加速，才像呼吸而非机械往复。
         ⚠ 呼吸的**主体是光晕明灭，不是球体胀缩**。实测过：2.4s 周期下，
         球体缩放 2.2% 在屏幕上只产生 4 级可分辨状态（每 0.6s 跳一级，看起来就是掉帧），
         幅度加到 10%（14px）也才 9 级——「又慢又小」的几何位移必然被像素量化。
         透明度是 8 位连续量，同样时长里能给出 20+ 级，所以让它挑大梁；
         缩放降为辅助，提供一点形变感即可。 -->
    <Duration x:Key="Motion.Duration.Breath">0:0:2.4</Duration>
    <!-- 连接中的脉冲比呼吸急促，读作「在使劲」 -->
    <Duration x:Key="Motion.Duration.Pulse">0:0:1.0</Duration>
    <Duration x:Key="Motion.Duration.Press">0:0:0.09</Duration>
    <Duration x:Key="Motion.Duration.Spring">0:0:0.6</Duration>
    <Duration x:Key="Motion.Duration.Slide">0:0:0.34</Duration>

    <SineEase x:Key="Motion.Ease.Breath" EasingMode="EaseInOut" />

    <!-- 呼吸与脉冲的透明度区间。做成 token 有两个理由：
         一是 Tests/OrbFrameProbe.cs 要按同一份数字回放动画曲线来数可分辨级数，
         写两份迟早各改各的；二是这几个值是调过的，改动幅度要连着级数一起复核。 -->
    <sys:Double x:Key="Motion.Orb.BreathAlphaFrom">0.04</sys:Double>
    <sys:Double x:Key="Motion.Orb.BreathAlphaTo">0.58</sys:Double>
    <sys:Double x:Key="Motion.Orb.PulseAlphaFrom">0.05</sys:Double>
    <sys:Double x:Key="Motion.Orb.PulseAlphaTo">0.72</sys:Double>
    <!-- 缩放是辅助。它是几何位移，会被像素量化成个位数的级数，加大也救不了，
         加大到能流畅的程度就不温润了。真正扛连续感的是上面的透明度。 -->
    <sys:Double x:Key="Motion.Orb.BreathScale">1.05</sys:Double>
    <sys:Double x:Key="Motion.Orb.PulseScale">1.07</sys:Double>
    <!-- 松手回弹：两次振荡就收住，再多会读成故障 -->
    <ElasticEase x:Key="Motion.Ease.Spring" EasingMode="EaseOut" Oscillations="2" Springiness="6" />
    <CubicEase x:Key="Motion.Ease.Slide" EasingMode="EaseOut" />
    <BackEase x:Key="Motion.Ease.Overshoot" EasingMode="EaseOut" Amplitude="0.35" />

    <!-- ============ Power 图标几何 ============
         40×40 盒内绘制：圆心 (20, 20.75)、半径 12、顶部开口 104° 的圆弧，
         加一条 x=20 的垂直轴线。用 Path 描边而非字体字形，任何 DPI 下都解析式锐利。

         两处都不能靠推理，必须实测（Tests/PowerIconProbe.cs 会算包围盒并断言）：

         1. **sweep 必须是 0**。large-arc 与 sweep 共同决定圆心落在弦的哪一侧，
            实测 large=1/sweep=1 会把圆心推到盒子上方（墨迹 T=-6.92），弧只剩两截
            「括号」露在盒内——而那在 140px 的球上不放大仍像个 power 图标。
            large=1/sweep=0 才是圆心在下方、弧伸到 B=33.64 的那条。
         2. 坐标要让**墨迹包围盒**（含 0.9 的半描边）居中，而不是让圆心居中：
            弧只占下方大半圈、竖线只占上半，两者的几何中心都不等于视觉中心。
            当前值实测 ink = L7.14 T6.35 R32.86 B33.64，中心 (20.00, 20.00)。 -->
    <PathGeometry x:Key="Geometry.PowerArc"
                  Figures="M 10.54,13.36 A 12,12 0 1 0 29.46,13.36" />
    <PathGeometry x:Key="Geometry.PowerStem"
                  Figures="M 20,7.25 L 20,18.75" />

    <!-- ============ 能量球 ============ -->
    <Style x:Key="OrbButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="{StaticResource Size.OrbHalo}" />
        <Setter Property="Height" Value="{StaticResource Size.OrbHalo}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- 两层 ScaleTransform：呼吸与按压各占一层，否则两个动画抢同一个属性，
                         松手回弹会把呼吸的当前相位一并清零，看起来像卡了一下。 -->
                    <Grid x:Name="PressHost" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <!-- ⚠ 下面两层投影带 DropShadowEffect，必须留在 BreathHost **外面**。
                             呼吸是 RepeatBehavior=Forever 的，被它缩放的子树每帧都要把
                             Effect 整个重算一遍。搬出来之后，每帧缩放的子树里一个都没有。
                             视觉代价为零：投影差那几个百分点看不出来。按压缩放仍然会
                             带上它们——那是偶发的，且物体被按下去时影子跟着变才对。

                             光晕已改用径向渐变、不再有 Effect，但同样留在外面：
                             它本就不该跟着球胀缩，只明灭。 -->

                        <!-- 外晕：贴着球缘的一圈细环，呼吸时明灭。未连接时全透明。 -->
                        <Ellipse x:Name="Halo"
                                 Width="{StaticResource Size.OrbGlow}"
                                 Height="{StaticResource Size.OrbGlow}"
                                 Fill="{StaticResource Brush.Halo.Accent}"
                                 Opacity="0"
                                 IsHitTestVisible="False" />

                        <!-- 承影层：实色圆只为投影存在，被上面的球体完全盖住。
                             呼吸只放大不缩小（1 → Motion.Orb.BreathScale，现为 1.05），
                             所以球永远盖得住这两个 140 的圆，不会在边缘露出白边。 -->
                        <Ellipse x:Name="AmbientShadow"
                                 Width="{StaticResource Size.Orb}"
                                 Height="{StaticResource Size.Orb}"
                                 Fill="{StaticResource Brush.Surface}"
                                 Effect="{StaticResource Shadow.OrbAmbient}"
                                 IsHitTestVisible="False" />
                        <Ellipse x:Name="ContactShadow"
                                 Width="{StaticResource Size.Orb}"
                                 Height="{StaticResource Size.Orb}"
                                 Fill="{StaticResource Brush.Surface}"
                                 Effect="{StaticResource Shadow.OrbContact}"
                                 IsHitTestVisible="False" />

                        <Grid x:Name="BreathHost" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BreathScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <Ellipse x:Name="Orb"
                                     Width="{StaticResource Size.Orb}"
                                     Height="{StaticResource Size.Orb}"
                                     Fill="{StaticResource Brush.Orb.Idle}"
                                     Stroke="{StaticResource Brush.BorderStrong}"
                                     StrokeThickness="{StaticResource Size.GlazeRim}" />

                            <!-- 镜面高光：贴在球体上半，让球读作被单一光源照亮 -->
                            <Ellipse x:Name="Specular"
                                     Width="{StaticResource Size.OrbSpecularWidth}"
                                     Height="{StaticResource Size.OrbSpecularHeight}"
                                     Fill="{StaticResource Brush.Orb.Specular}"
                                     VerticalAlignment="Top"
                                     Margin="0,40,0,0"
                                     IsHitTestVisible="False" />

                            <Canvas x:Name="IconCanvas"
                                    Width="{StaticResource Size.OrbIcon}"
                                    Height="{StaticResource Size.OrbIcon}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <Path x:Name="PowerArc"
                                      Data="{StaticResource Geometry.PowerArc}"
                                      Stroke="{StaticResource Brush.TextSecondary}"
                                      StrokeThickness="{StaticResource Stroke.OrbIcon}"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path x:Name="PowerStem"
                                      Data="{StaticResource Geometry.PowerStem}"
                                      Stroke="{StaticResource Brush.TextSecondary}"
                                      StrokeThickness="{StaticResource Stroke.OrbIcon}"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 已连接：翠绿球 + 平缓呼吸 -->
                        <DataTrigger Binding="{Binding State}" Value="Connected">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource Brush.Orb.Connected}" />
                            <Setter TargetName="Orb" Property="Stroke" Value="{StaticResource Brush.SuccessGlow}" />
                            <Setter TargetName="Halo" Property="Fill" Value="{StaticResource Brush.Halo.Success}" />
                            <Setter TargetName="PowerArc" Property="Stroke" Value="{StaticResource Brush.SuccessText}" />
                            <Setter TargetName="PowerStem" Property="Stroke" Value="{StaticResource Brush.SuccessText}" />
</DataTrigger>

                        <!-- 连接中：蔚蓝球 + 急促脉冲 -->
                        <DataTrigger Binding="{Binding State}" Value="Connecting">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource Brush.Orb.Accent}" />
                            <Setter TargetName="Orb" Property="Stroke" Value="{StaticResource Brush.AccentGlow}" />
                            <Setter TargetName="Halo" Property="Fill" Value="{StaticResource Brush.Halo.Accent}" />
                            <Setter TargetName="PowerArc" Property="Stroke" Value="{StaticResource Brush.AccentText}" />
                            <Setter TargetName="PowerStem" Property="Stroke" Value="{StaticResource Brush.AccentText}" />
</DataTrigger>

                        <DataTrigger Binding="{Binding State}" Value="Disconnecting">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource Brush.Orb.Accent}" />
                            <Setter TargetName="Orb" Property="Stroke" Value="{StaticResource Brush.AccentGlow}" />
                            <Setter TargetName="PowerArc" Property="Stroke" Value="{StaticResource Brush.AccentText}" />
                            <Setter TargetName="PowerStem" Property="Stroke" Value="{StaticResource Brush.AccentText}" />
                            <Setter TargetName="Orb" Property="Opacity" Value="0.6" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding State}" Value="Error">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource Brush.Orb.Error}" />
                            <Setter TargetName="Orb" Property="Stroke" Value="{StaticResource Brush.ErrorGlow}" />
                            <Setter TargetName="Halo" Property="Fill" Value="{StaticResource Brush.Halo.Error}" />
                            <Setter TargetName="Halo" Property="Opacity" Value="0.10" />
                            <Setter TargetName="PowerArc" Property="Stroke" Value="{StaticResource Brush.ErrorText}" />
                            <Setter TargetName="PowerStem" Property="Stroke" Value="{StaticResource Brush.ErrorText}" />
                        </DataTrigger>

                        <!-- 放在状态触发器之后：同为 Setter 时后声明者胜，
                             这条要能盖掉 Connected 的绿色。 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding State}" Value="Connected" />
                                <Condition Binding="{Binding CheckSeverity}" Value="Bad" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource Brush.Orb.Error}" />
                            <Setter TargetName="Orb" Property="Stroke" Value="{StaticResource Brush.ErrorGlow}" />
                            <Setter TargetName="Halo" Property="Fill" Value="{StaticResource Brush.Halo.Error}" />
                            <Setter TargetName="PowerArc" Property="Stroke" Value="{StaticResource Brush.ErrorText}" />
                            <Setter TargetName="PowerStem" Property="Stroke" Value="{StaticResource Brush.ErrorText}" />
                        </MultiDataTrigger>

                        <!-- 仅可见主页且系统允许动画时呼吸；阴影留在缩放子树之外。 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding State}" Value="Connected" />
                                <Condition Binding="{Binding CanAnimate}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="BreathBegin">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="BreathScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="{StaticResource Motion.Orb.BreathScale}"
                                                         Duration="{StaticResource Motion.Duration.Breath}"
                                                         EasingFunction="{StaticResource Motion.Ease.Breath}" />
                                        <DoubleAnimation Storyboard.TargetName="BreathScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="{StaticResource Motion.Orb.BreathScale}"
                                                         Duration="{StaticResource Motion.Duration.Breath}"
                                                         EasingFunction="{StaticResource Motion.Ease.Breath}" />
                                        <DoubleAnimation Storyboard.TargetName="Halo"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="{StaticResource Motion.Orb.BreathAlphaFrom}"
                                                         To="{StaticResource Motion.Orb.BreathAlphaTo}"
                                                         Duration="{StaticResource Motion.Duration.Breath}"
                                                         EasingFunction="{StaticResource Motion.Ease.Breath}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="BreathBegin" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- 连接状态仍由文字和釉色表达；关闭动画后无需持续绘制。 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding State}" Value="Connecting" />
                                <Condition Binding="{Binding CanAnimate}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PulseBegin">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="BreathScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="{StaticResource Motion.Orb.PulseScale}"
                                                         Duration="{StaticResource Motion.Duration.Pulse}"
                                                         EasingFunction="{StaticResource Motion.Ease.Breath}" />
                                        <DoubleAnimation Storyboard.TargetName="BreathScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="{StaticResource Motion.Orb.PulseScale}"
                                                         Duration="{StaticResource Motion.Duration.Pulse}"
                                                         EasingFunction="{StaticResource Motion.Ease.Breath}" />
                                        <DoubleAnimation Storyboard.TargetName="Halo"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="{StaticResource Motion.Orb.PulseAlphaFrom}"
                                                         To="{StaticResource Motion.Orb.PulseAlphaTo}"
                                                         Duration="{StaticResource Motion.Duration.Pulse}"
                                                         EasingFunction="{StaticResource Motion.Ease.Breath}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PulseBegin" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Specular" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.02"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.02"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Base}"
                                                         EasingFunction="{StaticResource Motion.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 按下瞬间线性缩到 0.93，松手用 ElasticEase 回弹：
                             按下要「跟手」所以不加缓动，回弹才是弹簧该出现的地方。 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.93"
                                                         Duration="{StaticResource Motion.Duration.Press}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.93"
                                                         Duration="{StaticResource Motion.Duration.Press}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Spring}"
                                                         EasingFunction="{StaticResource Motion.Ease.Spring}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Spring}"
                                                         EasingFunction="{StaticResource Motion.Ease.Spring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Orb" Property="Opacity" Value="0.5" />
                            <Setter TargetName="AmbientShadow" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 模式滑动开关 ============ -->
    <Style x:Key="ModeSwitchItemStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Label"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeSwitchStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Width" Value="{StaticResource Size.ContentWidth}" />
        <Setter Property="Height" Value="{StaticResource Size.ModeTrackHeight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid>
                        <!-- 凹陷轨道：比基座亮一档的釉白，读作被压下去的一层 -->
                        <Border CornerRadius="{StaticResource Radius.Pill}"
                                Background="{StaticResource Brush.SurfaceSunken}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="{StaticResource Thickness.Hairline}" />

                        <!-- 滑块：纯白 + 接触影，浮在轨道上 -->
                        <Border x:Name="Thumb"
                                Width="{StaticResource Size.ModeThumbWidth}"
                                Height="{StaticResource Size.ModeThumbHeight}"
                                HorizontalAlignment="Left"
                                Margin="{StaticResource Thickness.ModeThumbInset}"
                                CornerRadius="{StaticResource Radius.ModeThumb}"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="{StaticResource Thickness.Hairline}"
                                Effect="{StaticResource Shadow.Contact}"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbShift" X="0" />
                            </Border.RenderTransform>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0"
                                         GroupName="ProxyMode"
                                         Content="智能分流"
                                         Style="{StaticResource ModeSwitchItemStyle}"
                                         IsChecked="{Binding IsRuleMode, Mode=TwoWay}"
                                         IsEnabled="{Binding IsModeSelectionEnabled}" />
                            <RadioButton Grid.Column="1"
                                         GroupName="ProxyMode"
                                         Content="全局代理"
                                         Style="{StaticResource ModeSwitchItemStyle}"
                                         IsChecked="{Binding IsGlobalMode, Mode=TwoWay}"
                                         IsEnabled="{Binding IsModeSelectionEnabled}" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsGlobalMode}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Size.ModeThumbTravel}"
                                                         Duration="{StaticResource Motion.Duration.Slide}"
                                                         EasingFunction="{StaticResource Motion.Ease.Slide}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Slide}"
                                                         EasingFunction="{StaticResource Motion.Ease.Slide}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsModeSelectionEnabled}" Value="False">
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 检测按钮（浮空白胶囊） ============ -->
    <Style x:Key="CheckButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource Size.CheckButton}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource Thickness.CheckPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- 双层 Border = 双层阴影：外层散影拉开与基座的距离，内层接触影收住边缘 -->
                    <Border x:Name="AmbientLayer"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Background="{StaticResource Brush.Surface}"
                            Effect="{StaticResource Shadow.Ambient}">
                        <Border x:Name="ContactLayer"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="{StaticResource Thickness.Hairline}"
                                Effect="{StaticResource Shadow.Contact}">
                            <ContentPresenter x:Name="Label"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContactLayer" Property="Background" Value="{StaticResource Brush.SurfaceSunken}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="AmbientLayer" Property="Effect" Value="{StaticResource Shadow.Contact}" />
                            <Setter TargetName="ContactLayer" Property="Background" Value="{StaticResource Brush.SurfaceSunken}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                            <Setter TargetName="AmbientLayer" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="ContactLayer" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="ContactLayer" Property="Background" Value="{StaticResource Brush.SurfaceSunken}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 自检结果行 ============ -->
    <Style x:Key="CheckResultTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding CheckSeverity}" Value="Good">
                <Setter Property="Foreground" Value="{StaticResource Brush.SuccessText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CheckSeverity}" Value="Bad">
                <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 速率箭头 ============
         与 chevron 共用 Stroke.Icon，让两处图标的视重一致。 -->
    <sys:Double x:Key="Size.TrafficArrow">11</sys:Double>

    <Style x:Key="TrafficArrowStyle" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="{StaticResource Size.TrafficArrow}" />
        <Setter Property="Height" Value="{StaticResource Size.TrafficArrow}" />
        <Setter Property="Stroke" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="StrokeThickness" Value="{StaticResource Stroke.Icon}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ 速率标签 ============
         等宽数字（Segoe UI 的 lnum/tnum）让数值跳动时字符不横向抖动。 -->
    <Style x:Key="TrafficLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ============ 主页标题（浮空层弱化版） ============
         能量球是页面唯一的视觉中心，标题退成一行标签。BindView / SettingsView
         仍用 PageTitleTextStyle，不受影响。 -->
    <Style x:Key="OrbPageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizeSecondary}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <!-- ============ 状态文字（浮空层放大版） ============ -->
    <Style x:Key="OrbStatusTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.SizePrimary}" />
        <!-- 适度字重：瓷是含蓄的，SemiBold 在这套低对比配色里会显得吵 -->
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
