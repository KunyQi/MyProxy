    <!-- ============ 别名令牌 ============
         同一个共享样式里、同一个属性在三套皮肤下取值不同的那些位置。
         取值从 windows/MyProxy/Themes/Ceramic.xaml 逐条比出来（.probe/skin-diff.py）
         并搬到这里，于是共享样式引用别名就能让三套皮肤都逐值一致。
         生成器里的表是三份皮肤共用的：任意一套缺一项，生成器直接报错。 -->
    <SolidColorBrush x:Key="Alias.OrbRim.Idle" Color="{DynamicResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Alias.OrbRim.Connected" Color="{DynamicResource Color.SuccessText}" />
    <SolidColorBrush x:Key="Alias.OrbRim.Connecting" Color="{DynamicResource Color.AccentText}" />
    <SolidColorBrush x:Key="Alias.OrbRim.Error" Color="{DynamicResource Color.ErrorText}" />
    <SolidColorBrush x:Key="Alias.OrbIcon.Idle" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Alias.OrbIcon.Connected" Color="{DynamicResource Color.SuccessText}" />
    <SolidColorBrush x:Key="Alias.OrbIcon.Connecting" Color="{DynamicResource Color.AccentText}" />
    <SolidColorBrush x:Key="Alias.OrbIcon.Error" Color="{DynamicResource Color.ErrorText}" />
    <x:Double x:Key="Alias.OrbSpecularWidth">60</x:Double>
    <x:Double x:Key="Alias.OrbSpecularHeight">36</x:Double>
    <Thickness x:Key="Alias.OrbSpecularMargin">55,50,0,0</Thickness>
    <HorizontalAlignment x:Key="Alias.OrbSpecularAlign">Left</HorizontalAlignment>
    <x:String x:Key="Alias.OrbHoverScale">1.02</x:String>
    <x:String x:Key="Alias.OrbPressScale">0.95</x:String>
    <LinearGradientBrush x:Key="Alias.CheckFill.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFEFC" />
        <GradientStop Offset="0.52" Color="#FAF7F0" />
        <GradientStop Offset="1" Color="#EAE2D2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Alias.CheckFill.Pressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFEFC" />
        <GradientStop Offset="0.52" Color="#FAF7F0" />
        <GradientStop Offset="1" Color="#EAE2D2" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Alias.CheckFill.Disabled" Color="{DynamicResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Alias.FocusRingBrush" Color="{DynamicResource Color.AccentText}" />
    <SolidColorBrush x:Key="Alias.StatusText.Connected" Color="{DynamicResource Color.SuccessText}" />
    <SolidColorBrush x:Key="Alias.StatusText.Connecting" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Alias.StatusText.Error" Color="{DynamicResource Color.ErrorText}" />
    <SolidColorBrush x:Key="Alias.TextLink.HoverFill" Color="#96FFFFFF" />
    <SolidColorBrush x:Key="Alias.TextLink.HoverStroke" Color="{DynamicResource Color.BorderStrong}" />
</ResourceDictionary>
