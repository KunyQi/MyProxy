    <x:Double x:Key="Size.Control">36</x:Double>
    <x:Double x:Key="Size.PrimaryButton">40</x:Double>
    <x:Double x:Key="Size.TextLink">28</x:Double>
    <x:Double x:Key="Size.SettingsRow">44</x:Double>
    <x:Double x:Key="Size.NavBar">52</x:Double>
    <x:Double x:Key="Size.SwitchTrackWidth">40</x:Double>
    <x:Double x:Key="Size.SwitchTrackHeight">20</x:Double>
    <x:Double x:Key="Size.SwitchThumb">14</x:Double>
    <x:Double x:Key="Size.SwitchThumbTravel">20</x:Double>
    <x:Double x:Key="Size.Hairline">1</x:Double>
