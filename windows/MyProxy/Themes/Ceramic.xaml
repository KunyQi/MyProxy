<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
    ================================================================================
    釉陶（Ceramic）
    ================================================================================
    与另两套同骨不同皮：间距、尺寸、字号、图标坐标与 DesignTokens.xaml 逐值相同。
    分岔在材质模型上——这一套里，界面是一件**上了釉的胎体**：

      凸起（Raised）  可以按的东西：按钮、滑块、检测胶囊、能量球。
                      釉在顶缘受光，底缘留一道回光，下面压着一层接触影。
      凹陷（Recessed）可以填的东西：输入框、开关轨道、分段托盘。
                      顶缘落影、底唇积光——凸起的完全反相。
      按下（Pressed） 物件真的陷进胎里：整体下移 1px，釉从凸翻凹，
                      顶缘的高光挪到底缘，接触影消失。

    三条硬规则：
      1. 光只有一个，来自上方。任何一处底缘比顶缘更亮的凸面都是错的。
      2. 按下改变的是**材质**，不是颜色。色相在按下前后不变。
      3. 禁用 = 素胎（bisque）：烧过没上釉，无渐变、无高光、无影。

    WPF 一个元素只能挂一个 Effect，所以「釉」不靠多层阴影堆，而是：
      渐变填充负责釉面受光（Glaze.* 私有笔刷，胎色已烘进渐变里），
      一条 1px 的单边 Border 负责顶缘高光 / 底唇回光，
      元素自己的 Effect 负责它与基座的关系。
    ================================================================================
    -->

    <!-- ============ 颜色 Token ============
         胎是暖白瓷，釉是青瓷，暗部是陶土。没有纯白也没有纯黑。 -->
    <Color x:Key="Color.Background">#F2EEE6</Color>
    <Color x:Key="Color.Surface">#FCFAF6</Color>
    <!-- 凹陷面：比基座再暗一档，凹进去的东西必须比它周围暗，否则读不成「洞」 -->
    <Color x:Key="Color.SurfaceSunken">#EAE5DA</Color>
    <Color x:Key="Color.TextPrimary">#1F1E1A</Color>
    <Color x:Key="Color.TextSecondary">#5A564E</Color>
    <Color x:Key="Color.TextDisabled">#8F8A7E</Color>
    <!-- 釉断线：釉在边缘变薄处显出的那道色。比瓷白的发丝线重一档，
         因为这套皮肤的边缘要承担「收口」而不只是「分隔」。 -->
    <Color x:Key="Color.Border">#DFD9CC</Color>
    <Color x:Key="Color.BorderStrong">#CFC8B9</Color>

    <!-- 青瓷釉。刻意是**淡的**：真正的青瓷釉色浅，深色是胎不是釉。
         于是主按钮是「青釉面 + 深色字」，不是「饱和色块 + 白字」。 -->
    <Color x:Key="Color.Accent">#ADC4B8</Color>
    <Color x:Key="Color.AccentHover">#C8D9D0</Color>
    <Color x:Key="Color.AccentPressed">#8EA99B</Color>
    <Color x:Key="Color.AccentGlow">#8EA99B</Color>
    <Color x:Key="Color.AccentDeep">#8EA99B</Color>
    <!-- 文字色：#4E6B5B 于胎白 5.9:1 -->
    <Color x:Key="Color.AccentText">#4E6B5B</Color>

    <Color x:Key="Color.Success">#8FAE85</Color>
    <Color x:Key="Color.SuccessGlow">#8FAE85</Color>
    <Color x:Key="Color.SuccessDeep">#527346</Color>
    <!-- 文字：6.4:1 于胎白 -->
    <Color x:Key="Color.SuccessText">#3E5A36</Color>

    <!-- 铁釉（天目）：这套皮肤的破坏色不是正红，是烧出来的锈。 -->
    <Color x:Key="Color.Error">#B0705A</Color>
    <Color x:Key="Color.ErrorGlow">#CD9986</Color>
    <Color x:Key="Color.ErrorDeep">#96543F</Color>
    <!-- 文字：6.6:1 于胎白 -->
    <Color x:Key="Color.ErrorText">#79402E</Color>

    <Color x:Key="Color.Connecting">#ADC4B8</Color>

    <!-- 影子偏暖，朝陶土走。纯黑压在这套暖色上会发脏。 -->
    <Color x:Key="Color.Shadow">#241F16</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Connecting" Color="{StaticResource Color.Connecting}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="{StaticResource Color.SuccessText}" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="{StaticResource Color.ErrorText}" />
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="{StaticResource Color.AccentGlow}" />
    <SolidColorBrush x:Key="Brush.SuccessGlow" Color="{StaticResource Color.SuccessGlow}" />
    <SolidColorBrush x:Key="Brush.ErrorGlow" Color="{StaticResource Color.ErrorGlow}" />
    <!-- 球缘的收口线用深一档的釉色：厚釉在转折处堆积，边缘就是比面积色深。
         另两套皮肤用不上，所以只在釉陶里建。 -->
    <SolidColorBrush x:Key="Brush.SuccessDeep" Color="{StaticResource Color.SuccessDeep}" />
    <SolidColorBrush x:Key="Brush.ErrorDeep" Color="{StaticResource Color.ErrorDeep}" />

    <!-- ============ 釉（本皮肤私有） ============
         胎色已经烘进每条渐变里，所以一个元素一层填充就够——不需要在实色上再叠
         一层半透明渐变，那会多一个渲染层且在圆角处露边。

         命名规则：Glaze.<胎>.<形>。Convex 顶亮底暗，Concave 顶暗底亮。
         两者的色差都压在 4% 明度以内：釉是薄的，不是塑料壳。 -->
    <LinearGradientBrush x:Key="Glaze.Surface.Convex" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFEFC" Offset="0" />
        <GradientStop Color="#FAF7F0" Offset="0.52" />
        <GradientStop Color="#EAE2D2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glaze.Surface.Concave" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E5DDCC" Offset="0" />
        <GradientStop Color="#F3EFE4" Offset="0.62" />
        <GradientStop Color="#FEFDFA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glaze.Well.Concave" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CEC5B0" Offset="0" />
        <GradientStop Color="#E3DDCF" Offset="0.55" />
        <GradientStop Color="#F8F5EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glaze.Bar.Plinth" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFEFB" Offset="0" />
        <GradientStop Color="#F8F5EC" Offset="0.6" />
        <GradientStop Color="#EFE9DC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glaze.Accent.Convex" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D6E4DB" Offset="0" />
        <GradientStop Color="#B5CABE" Offset="0.52" />
        <GradientStop Color="#92AC9E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glaze.Accent.Concave" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#87A295" Offset="0" />
        <GradientStop Color="#A0B9AC" Offset="0.6" />
        <GradientStop Color="#C5D8CE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glaze.Error.Convex" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CA9880" Offset="0" />
        <GradientStop Color="#B0705A" Offset="0.52" />
        <GradientStop Color="#934F3A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glaze.Track.Concave" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C5BCA6" Offset="0" />
        <GradientStop Color="#DAD3C3" Offset="0.55" />
        <GradientStop Color="#F2EEE5" Offset="1" />
    </LinearGradientBrush>
    <!-- 素胎：禁用态。烧过没上釉，所以它是唯一一块**平的**面。 -->
    <SolidColorBrush x:Key="Glaze.Bisque" Color="#E4DFD2" />

    <!-- 倒角的四条画笔。一件凸起的瓷有**两条**边：顶缘受光（Rim），底缘是它自己的
         厚度投下的暗边（Shade）。只画顶缘那一条时，物件看着像贴上去的纸片；
         两条都画，它才有厚度。凹陷则完全反过来：顶缘落影，底唇积光（Bounce）。 -->
    <SolidColorBrush x:Key="Brush.Glaze.Rim" Color="#96FFFFFF" />
    <SolidColorBrush x:Key="Brush.Glaze.Bounce" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="Brush.Glaze.Shade" Color="#33241F16" />

    <!-- ============ 光晕 ============
         几何与另两套一致（RadiusX/Y=0.5，球缘 0.864 外四档单调衰减）。
         釉陶的光晕最实：釉面本来就会把光反出来。 -->
    <RadialGradientBrush x:Key="Brush.Halo.Accent" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0.00" Color="#FF8EA99B" />
        <GradientStop Offset="0.864" Color="#FF8EA99B" />
        <GradientStop Offset="0.902" Color="#A88EA99B" />
        <GradientStop Offset="0.939" Color="#5A8EA99B" />
        <GradientStop Offset="0.972" Color="#228EA99B" />
        <GradientStop Offset="1.000" Color="#008EA99B" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Halo.Success" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0.00" Color="#FF8FAE85" />
        <GradientStop Offset="0.864" Color="#FF8FAE85" />
        <GradientStop Offset="0.902" Color="#A88FAE85" />
        <GradientStop Offset="0.939" Color="#5A8FAE85" />
        <GradientStop Offset="0.972" Color="#228FAE85" />
        <GradientStop Offset="1.000" Color="#008FAE85" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Halo.Error" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0.00" Color="#FFB0705A" />
        <GradientStop Offset="0.864" Color="#FFB0705A" />
        <GradientStop Offset="0.902" Color="#A8B0705A" />
        <GradientStop Offset="0.939" Color="#5AB0705A" />
        <GradientStop Offset="0.972" Color="#22B0705A" />
        <GradientStop Offset="1.000" Color="#00B0705A" />
    </RadialGradientBrush>

    <!-- ============ 球面釉色 ============
         这一套的球要读成**一个被照亮的立体**，不是一块发光的圆片，所以它和另两套
         走的是相反的路子：

         经典/瓷白把 GradientOrigin 钉在正中心，让釉色均匀绕满一周（「釉在边缘堆积」）。
         这里**故意偏心**到左上 (0.36,0.30)：渐变中心一偏，同一个半径上的明度就不再
         相等，于是亮面在左上、暗面在右下——这正是单一光源照在球上的样子。

         偏心的代价是最深的一档不再均匀落在球缘（经典的注释记过这个坑），
         但那条约束服务的是「釉色均匀」，而拟物要的恰恰是不均匀。
         RadiusX/Y 放大到 0.62 补偿偏心带来的裁切，让最暗那档仍然铺到右下的球缘。

         胎色不再是纯白：白心会把镜面高光整个吞掉，高光也就没法作为独立的一层存在。 -->

    <RadialGradientBrush x:Key="Brush.Orb.Idle"
                         GradientOrigin="0.36,0.30" Center="0.5,0.5"
                         RadiusX="0.62" RadiusY="0.62">
        <GradientStop Color="#FFFEFB" Offset="0" />
        <GradientStop Color="#F6F1E4" Offset="0.35" />
        <GradientStop Color="#E2D9C4" Offset="0.72" />
        <GradientStop Color="#BFB397" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="Brush.Orb.Connected"
                         GradientOrigin="0.36,0.30" Center="0.5,0.5"
                         RadiusX="0.62" RadiusY="0.62">
        <GradientStop Color="#EDF4E9" Offset="0" />
        <GradientStop Color="#C9DCC1" Offset="0.35" />
        <GradientStop Color="#9CBD8F" Offset="0.72" />
        <GradientStop Color="#6C8C61" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="Brush.Orb.Accent"
                         GradientOrigin="0.36,0.30" Center="0.5,0.5"
                         RadiusX="0.62" RadiusY="0.62">
        <GradientStop Color="#EBF2ED" Offset="0" />
        <GradientStop Color="#C9DCD1" Offset="0.35" />
        <GradientStop Color="#A2BEAF" Offset="0.72" />
        <GradientStop Color="#74907E" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="Brush.Orb.Error"
                         GradientOrigin="0.36,0.30" Center="0.5,0.5"
                         RadiusX="0.62" RadiusY="0.62">
        <GradientStop Color="#F9EAE3" Offset="0" />
        <GradientStop Color="#E3BCA8" Offset="0.35" />
        <GradientStop Color="#C58A6D" Offset="0.72" />
        <GradientStop Color="#9A583C" Offset="1" />
    </RadialGradientBrush>

    <!-- 镜面高光：现在胎色不是白的了，这一层才真正看得见。
         中心给到 80%——厚釉的反光就是这么亮，收得也快（0.45 就掉到 18%）。 -->
    <RadialGradientBrush x:Key="Brush.Orb.Specular"
                         GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#CCFFFFFF" Offset="0" />
        <GradientStop Color="#2EFFFFFF" Offset="0.45" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <!-- ============ 字体 Token（与另两套逐值相同） ============ -->
    <FontFamily x:Key="Font.Family">Segoe UI, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="Font.SizeTitle">20</sys:Double>
    <sys:Double x:Key="Font.SizePrimary">16</sys:Double>
    <sys:Double x:Key="Font.SizeBody">14</sys:Double>
    <sys:Double x:Key="Font.SizeSecondary">13</sys:Double>
    <sys:Double x:Key="Font.SizeCaption">12</sys:Double>

    <!-- ============ 间距（与另两套逐值相同） ============ -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.SM">8</sys:Double>
    <sys:Double x:Key="Space.MD">12</sys:Double>
    <sys:Double x:Key="Space.LG">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <sys:Double x:Key="Space.XXL">32</sys:Double>
    <sys:Double x:Key="Space.Detach">64</sys:Double>


    <CornerRadius x:Key="Radius.SM">8</CornerRadius>
    <CornerRadius x:Key="Radius.MD">10</CornerRadius>
    <CornerRadius x:Key="Radius.ModeThumb">10</CornerRadius>
    <CornerRadius x:Key="Radius.SwitchThumb">5</CornerRadius>
    <!-- 轨道内的强调色叠加层被 1px 边框内缩，按同一条同心规则：6 − 1 = 5。
         用 6 会让它的圆角比应在的位置外鼓，四角露出底下的 Brush.Surface，
         开启态就会在四个角上出现一圈骨白毛边。 -->
    <CornerRadius x:Key="Radius.SwitchTrackInner">5</CornerRadius>
    <CornerRadius x:Key="Radius.LG">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">14</CornerRadius>
    <CornerRadius x:Key="Radius.MD.Left">10,0,0,10</CornerRadius>
    <CornerRadius x:Key="Radius.MD.Right">0,10,10,0</CornerRadius>

    <!-- ============ 尺寸 Token（与另两套逐值相同） ============ -->
    <sys:Double x:Key="Size.ContentWidth">352</sys:Double>
    <sys:Double x:Key="Size.LinePrimary">24</sys:Double>
    <sys:Double x:Key="Size.LineSecondary">20</sys:Double>
    <sys:Double x:Key="Size.StatusGlyph">20</sys:Double>
    <sys:Double x:Key="Size.Spinner">12</sys:Double>
    <sys:Double x:Key="Size.Control">36</sys:Double>
    <sys:Double x:Key="Size.PrimaryButton">40</sys:Double>
    <sys:Double x:Key="Size.TextLink">28</sys:Double>
    <sys:Double x:Key="Size.SettingsRow">44</sys:Double>
    <sys:Double x:Key="Size.NavBar">52</sys:Double>
    <sys:Double x:Key="Size.SwitchTrackWidth">40</sys:Double>
    <sys:Double x:Key="Size.SwitchTrackHeight">20</sys:Double>
    <sys:Double x:Key="Size.SwitchThumb">14</sys:Double>
    <sys:Double x:Key="Size.SwitchThumbTravel">20</sys:Double>
    <sys:Double x:Key="Size.Hairline">1</sys:Double>

    <sys:Double x:Key="Stroke.Icon">1.5</sys:Double>
    <sys:Double x:Key="Stroke.Spinner">2</sys:Double>
    <sys:Double x:Key="Stroke.OrbIcon">1.8</sys:Double>

    <Thickness x:Key="Thickness.ButtonPadding">12,0</Thickness>
    <Thickness x:Key="Thickness.TextInputPadding">8,0</Thickness>
    <Thickness x:Key="Thickness.SwitchContentMargin">8,0,0,0</Thickness>
    <Thickness x:Key="Thickness.SwitchThumbLeft">2,0,0,0</Thickness>
    <Thickness x:Key="Thickness.None">0</Thickness>
    <Thickness x:Key="Thickness.PageVertical">0,24,0,24</Thickness>
    <Thickness x:Key="Thickness.Hairline">1</Thickness>
    <Thickness x:Key="Thickness.SegmentLeft">1,1,0,1</Thickness>
    <Thickness x:Key="Thickness.SegmentRight">0,1,1,1</Thickness>
    <Thickness x:Key="Thickness.TopXS">0,4,0,0</Thickness>
    <Thickness x:Key="Thickness.TopSM">0,8,0,0</Thickness>
    <Thickness x:Key="Thickness.TopMD">0,12,0,0</Thickness>
    <Thickness x:Key="Thickness.TopLG">0,16,0,0</Thickness>
    <Thickness x:Key="Thickness.TopXL">0,24,0,0</Thickness>
    <Thickness x:Key="Thickness.LeftXS">4,0,0,0</Thickness>
    <Thickness x:Key="Thickness.LeftSM">8,0,0,0</Thickness>

    <!-- 单边 1px：顶缘高光用 Top，底唇回光用 Bottom。釉陶私有。 -->
    <Thickness x:Key="Thickness.RimTop">0,1,0,0</Thickness>
    <Thickness x:Key="Thickness.RimBottom">0,0,0,1</Thickness>

    <!-- ============ 图标几何（与另两套逐值相同） ============ -->
    <PathGeometry x:Key="Geometry.ChevronRight" Figures="M 0.75,0.75 L 5.75,5.75 L 0.75,10.75" />
    <PathGeometry x:Key="Geometry.ChevronLeft" Figures="M 5.75,0.75 L 0.75,5.75 L 5.75,10.75" />
    <PathGeometry x:Key="Geometry.ArrowUp"
                  Figures="M 2.1,5.4 L 5.5,2 L 8.9,5.4 M 5.5,2 L 5.5,9" />
    <PathGeometry x:Key="Geometry.ArrowDown"
                  Figures="M 2.1,5.6 L 5.5,9 L 8.9,5.6 M 5.5,9 L 5.5,2" />
    <PathGeometry x:Key="Geometry.SpinnerArc" Figures="M 6,1 A 5,5 0 0 1 11,6" />
    <PathGeometry x:Key="Geometry.PowerArc"
                  Figures="M 10.54,13.36 A 12,12 0 1 0 29.46,13.36" />
    <PathGeometry x:Key="Geometry.PowerStem"
                  Figures="M 20,7.25 L 20,18.75" />


    <Duration x:Key="Motion.Duration.Fast">0:0:0.140</Duration>
    <Duration x:Key="Motion.Duration.Base">0:0:0.240</Duration>
    <Duration x:Key="Motion.Duration.SpinnerCycle">0:0:1.0</Duration>
    <CubicEase x:Key="Motion.Ease.Out" EasingMode="EaseOut" />

    <Duration x:Key="Motion.Duration.Breath">0:0:2.6</Duration>
    <Duration x:Key="Motion.Duration.Pulse">0:0:1.0</Duration>
    <Duration x:Key="Motion.Duration.Press">0:0:0.120</Duration>
    <Duration x:Key="Motion.Duration.Spring">0:0:0.320</Duration>
    <Duration x:Key="Motion.Duration.Slide">0:0:0.300</Duration>

    <SineEase x:Key="Motion.Ease.Breath" EasingMode="EaseInOut" />
    <!-- 只振一次就收住：陶是致密的，振两次会读成塑料。 -->
    <ElasticEase x:Key="Motion.Ease.Spring" EasingMode="EaseOut" Oscillations="1" Springiness="7" />
    <!-- 滑块落进凹槽会过冲一点点再坐稳，所以 Slide 用 BackEase 而不是 Cubic。 -->
    <BackEase x:Key="Motion.Ease.Slide" EasingMode="EaseOut" Amplitude="0.22" />
    <BackEase x:Key="Motion.Ease.Overshoot" EasingMode="EaseOut" Amplitude="0.30" />

    <sys:Double x:Key="Motion.Orb.BreathAlphaFrom">0.06</sys:Double>
    <sys:Double x:Key="Motion.Orb.BreathAlphaTo">0.52</sys:Double>
    <sys:Double x:Key="Motion.Orb.PulseAlphaFrom">0.08</sys:Double>
    <sys:Double x:Key="Motion.Orb.PulseAlphaTo">0.70</sys:Double>
    <sys:Double x:Key="Motion.Orb.BreathScale">1.04</sys:Double>
