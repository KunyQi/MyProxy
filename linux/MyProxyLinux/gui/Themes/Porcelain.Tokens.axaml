    <DropShadowEffect x:Key="Shadow.OrbAmbient" OffsetX="-0.0" OffsetY="-0.0" BlurRadius="0.0" Color="{StaticResource Color.Shadow}" Opacity="0" />
    <DropShadowEffect x:Key="Shadow.OrbContact" OffsetX="-0.0" OffsetY="-0.0" BlurRadius="0.0" Color="{StaticResource Color.Shadow}" Opacity="0" />
