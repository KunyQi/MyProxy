    <!-- ============ 阴影 ============
         凸起的东西压着基座，所以接触影比另两套实一档；环境影则很散，
         说明「它离基座有多远」。 -->
    <DropShadowEffect x:Key="Shadow.Ambient" Color="{StaticResource Color.Shadow}"
                      BlurRadius="22" ShadowDepth="6" Direction="270"
                      Opacity="0.17" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Shadow.Contact" Color="{StaticResource Color.Shadow}"
                      BlurRadius="5" ShadowDepth="2" Direction="270"
                      Opacity="0.22" RenderingBias="Quality" />
